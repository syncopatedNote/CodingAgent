FROM python:3.11-slim

WORKDIR /app

# Install system deps needed for some python packages
RUN apt-get update && apt-get install -y --no-install-recommends build-essential libpq-dev git && rm -rf /var/lib/apt/lists/*

# Install Python deps for the RAG worker only
# (keep service-level deps separate; worker should install RAG/requirements.txt)
COPY RAG/requirements.txt /tmp/requirements-rag.txt
RUN pip install --no-cache-dir -r /tmp/requirements-rag.txt

# Copy entire repository so worker has access to framework_base and other modules
COPY . /app

# /app exposes the root packages so that 'import RAG.ingest' works correctly.
# We remove /app/RAG to avoid import ambiguity.
ENV PYTHONPATH=/app

# Default command; docker-compose will provide the --url arg
CMD ["rq", "worker"]
