# =============================================================================
# CONSOLIDATED DOCKER COMPOSE ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env and fill in your actual values

# -----------------------------------------------------------------------------
# LLM Provider Configuration
# -----------------------------------------------------------------------------
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
AZURE_API_KEY=your-azure-api-key-here
# Azure OpenAI (preferred): endpoint, deployment, api version and key
AZURE_OPENAI_API_KEY=your-azure-openai-api-key-here
AZURE_OPENAI_ENDPOINT=https://your-azure-openai-endpoint
AZURE_OPENAI_DEPLOYMENT=your-azure-deployment-name
AZURE_OPENAI_API_VERSION=2025-03-01-preview
# Gemini / Google (API key) or Vertex AI (project)
GEMINI_API_KEY=your-gemini-api-key-here
GOOGLE_API_KEY=your-google-api-key-here
GCP_PROJECT=your-gcp-project-id

# LLM Settings
LLM_PROVIDER=litellm
LLM_MODEL_NAME=gpt-4o-mini
LLM_MODEL_TYPE=chat

# LiteLLM Configuration
LITELLM_MASTER_KEY=sk-1234
LITELLM_PROXY_URL=http://litellm:4000
LITELLM_DB_PASSWORD=litellm_password

# -----------------------------------------------------------------------------
# AWS Bedrock Configuration
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1

# -----------------------------------------------------------------------------
# GitHub Integration
# -----------------------------------------------------------------------------
GITHUB_TOKEN=your-github-personal-access-token

# -----------------------------------------------------------------------------
# LangSmith Tracing (Optional)
# -----------------------------------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=your-project-name

# -----------------------------------------------------------------------------
# Atlassian (Confluence & Jira)
# -----------------------------------------------------------------------------
CONFLUENCE_URL=https://your-domain.atlassian.net
CONFLUENCE_USERNAME=your-email@example.com
CONFLUENCE_API_TOKEN=your-confluence-api-token
CONFLUENCE_SSL_VERIFY=false

JIRA_URL=https://your-domain.atlassian.net
JIRA_USERNAME=your-email@example.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PERSONAL_TOKEN=your-jira-personal-token
JIRA_SSL_VERIFY=false

# -----------------------------------------------------------------------------
# GitLab Integration
# -----------------------------------------------------------------------------
GITLAB_PERSONAL_ACCESS_TOKEN=your-gitlab-personal-access-token
GITLAB_API_URL=https://gitlab.com/api/v4
GITLAB_PROJECT_ID=your-project-id

# -----------------------------------------------------------------------------
# MCP Configuration
# -----------------------------------------------------------------------------
MCP_VERY_VERBOSE=true
MCP_ATLASSIAN_ENABLED=true
MCP_GITLAB_ENABLED=true
MCP_GITHUB_ENABLED=true

# -----------------------------------------------------------------------------
# MongoDB Configuration
# -----------------------------------------------------------------------------
MONGO_USERNAME=admin
MONGO_PASSWORD=password

# -----------------------------------------------------------------------------
# Development Rules (Optional)
# -----------------------------------------------------------------------------
DEVELOPMENT_RULES_PATH=path/to/rules
DEVELOPMENT_RULES_BRANCH=main

# -----------------------------------------------------------------------------
# Ollama Configuration (Optional - for local LLM)
# -----------------------------------------------------------------------------
OLLAMA_BASE_URL=http://host.docker.internal:11434

# -----------------------------------------------------------------------------
# Chroma (vector DB) Configuration
# -----------------------------------------------------------------------------
# When running a hosted Chroma server set these values.
# This project no longer supports file-based Chroma persistence.
CHROMA_SERVER_HOST=localhost
CHROMA_SERVER_HTTP_PORT=8000

# -----------------------------------------------------------------------------
# Embedding model (local HuggingFace)
# -----------------------------------------------------------------------------
# Model to use for local embedding generation using sentence-transformers
HF_EMBED_MODEL=sentence-transformers/all-mpnet-base-v2
# Device for embeddings: cpu, cuda, or mps
EMBED_DEVICE=cpu

# -----------------------------------------------------------------------------
# RAG Upload Service (S3 file uploads)
# Use a separate IAM user scoped to s3:PutObject on the upload bucket only.
# These are intentionally separate from AWS_ACCESS_KEY_ID above (Bedrock).
# -----------------------------------------------------------------------------
RAG_AWS_ACCESS_KEY_ID=your-rag-aws-access-key-id
RAG_AWS_SECRET_ACCESS_KEY=your-rag-aws-secret-access-key
RAG_AWS_REGION=us-east-1
S3_BUCKET_NAME=your-s3-bucket-name
PRESIGNED_URL_EXPIRY_SECONDS=300
