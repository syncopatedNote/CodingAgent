MCP_VERY_VERBOSE="true"
CONFLUENCE_URL=""
CONFLUENCE_USERNAME=""
CONFLUENCE_API_TOKEN=""
CONFLUENCE_SSL_VERIFY="false"
JIRA_URL=""
JIRA_PERSONAL_TOKEN=""
JIRA_SSL_VERIFY="false"
GITLAB_PERSONAL_ACCESS_TOKEN=""
GITLAB_API_URL=""
GITLAB_PROJECT_ID=""
DEVELOPMENT_RULES_PATH="/analysis"
DEVELOPMENT_RULES_BRANCH="Feature/AI-TEST-REPO-ANALYSIS"
OPENAI_API_KEY=""

# ============================================================================
# LLM Configuration
# ============================================================================
# Supported LLM Providers (llm_base.py):
# 
# 1. "ollama" - Direct connection to local Ollama server
#    - Requires: OLLAMA_BASE_URL
#    - Uses: ChatOllama or Ollama client
#    - Parameters: model, base_url, temperature
#    - Example: LLM_PROVIDER="ollama" with LLM_MODEL_NAME="llama3:8b"
#
# 2. "litellm" - Unified interface for OpenAI-compatible APIs
#    - For OpenAI: Requires OPENAI_API_KEY
#    - For Ollama: Prefix model with "ollama/" and set OLLAMA_BASE_URL
#    - Examples:
#      * LLM_PROVIDER="litellm" with LLM_MODEL_NAME="gpt-4o-mini"
#      * LLM_PROVIDER="litellm" with LLM_MODEL_NAME="ollama/llama3:8b"
#      * LLM_PROVIDER="litellm" with LLM_MODEL_NAME="gpt-4o"
#
# 3. "bedrock" - Direct AWS Bedrock integration
#    - Requires: AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_REGION
#    - Uses: BedrockChat (chat) or Bedrock (completion) with boto3 client
#    - Supports model shortcuts: "claude3", "claude2", "claude-instant", "titan", "llama2"
#    - Auto-detects anthropic_version for Claude models
#    - Example:
#      LLM_PROVIDER="bedrock"
#      LLM_MODEL_NAME="claude3"  # or full ID like "anthropic.claude-3-sonnet-20240229-v1:0"
#
# Note: LLM_MODEL_TYPE should be "chat" for conversational models (recommended)
# ============================================================================
LLM_PROVIDER="litellm"
LLM_MODEL_NAME="gpt-4o-mini"
LLM_MODEL_TYPE="chat"

# AWS Configuration (for Bedrock or other AWS services)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"

# Ollama Configuration (if using local ollama)
OLLAMA_BASE_URL="http://host.docker.internal:11434"
