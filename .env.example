# ============================================================================
# MCP SERVERS CONFIGURATION
# ============================================================================
MCP_VERY_VERBOSE="true"

# MCP Server URLs (optional - only needed for Docker Compose / SSE transport)
# Uncomment these when running via docker-compose:
# MCP_ATLASSIAN_URL="http://mcp-atlassian:3000"
# MCP_GITLAB_URL="http://localhost:3333/sse"
# MCP_GITHUB_URL="http://mcp-github:8080"

# ----------------------------------------------------------------------------
# Atlassian MCP Server (Confluence & Jira)
# ----------------------------------------------------------------------------
MCP_ATLASSIAN_ENABLED=false

CONFLUENCE_URL=""
CONFLUENCE_USERNAME=""
CONFLUENCE_API_TOKEN=""
CONFLUENCE_SSL_VERIFY="false"

JIRA_URL=""
JIRA_PERSONAL_TOKEN=""
JIRA_SSL_VERIFY="false"

# ----------------------------------------------------------------------------
# GitLab MCP Server
# ----------------------------------------------------------------------------
MCP_GITLAB_ENABLED=false

GITLAB_PERSONAL_ACCESS_TOKEN=""
GITLAB_API_URL=""
GITLAB_PROJECT_ID=""

# ----------------------------------------------------------------------------
# GitHub MCP Server
# ----------------------------------------------------------------------------
MCP_GITHUB_ENABLED=true
# GitHub token is also used for LLM access (see below)

# ============================================================================
# PROJECT CONFIGURATION
# ============================================================================
DEVELOPMENT_RULES_PATH="/analysis"
DEVELOPMENT_RULES_BRANCH="Feature/AI-TEST-REPO-ANALYSIS"

# ============================================================================
# LLM CONFIGURATION
# ============================================================================
LLM_PROVIDER="litellm"
LLM_MODEL_NAME="github/gpt-4o-mini"
LLM_MODEL_TYPE="chat"

# GitHub Copilot (used for both LLM access and GitHub MCP server)
GITHUB_TOKEN=""

# OpenAI (if using OpenAI models directly)
OPENAI_API_KEY=""

# AWS Bedrock (if using Bedrock models)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"

# Ollama (if using local Ollama)
OLLAMA_BASE_URL="http://host.docker.internal:11434"

# Anthropic (if using Claude models directly)
ANTHROPIC_API_KEY=<your-anthropic-api-key>
